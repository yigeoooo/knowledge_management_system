# Copy to a server-only secret store or .env.server. Never commit real values.

APP_ENV=server
APP_HOST=127.0.0.1
APP_PORT=5000

# 生产默认只输出慢 SQL / 失败 SQL；排查时设为 true 输出全部 SQL。
LOG_LEVEL=INFO
LOG_SQL_ENABLED=false
LOG_SQL_SLOW_MS=500
LOG_MAX_BODY_BYTES=8192

# Use an internal hostname or private network address on the server.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=knowledge_db
POSTGRES_USER=root
POSTGRES_PASSWORD=replace-with-secret

MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=replace-with-secret
MINIO_SECRET_KEY=replace-with-secret
MINIO_BUCKET=knowledge-documents
MINIO_SECURE=false
MINIO_URL_SECONDS=600
# 单文件上传上限：200 MB（字节），同时用于 Flask 请求体限制
MAX_DOCUMENT_SIZE=209715200

# Change this to the server's mounted document directory.
LOCAL_DOCUMENT_DIR=/srv/knowledge-management/documents

DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=replace-with-secret
DEEPSEEK_CHAT_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_SECONDS=60
# Cosine similarity cutoff; tune with actual knowledge-base questions.
QA_MIN_SIMILARITY=0.3
QA_RERANK_ENABLED=true
LANGCHAIN_CHAT_ENABLED=true
LANGCHAIN_STRUCTURED_OUTPUT=true
# Enable only after reviewing the data policy for sending traces to LangSmith.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=replace-with-secret
LANGSMITH_PROJECT=knowledge-management-system
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_SAMPLING_RATE=0.2
# 生产部署可设为 false，并单独运行 flask --app app qa-worker。
QA_WORKER_AUTOSTART=true
# 机器人单次 HTTP 请求等待答案的上限；客户端读取超时应大于该值。
ROBOT_ANSWER_WAIT_SECONDS=180
QA_LEASE_SECONDS=300
QA_MAX_ATTEMPTS=3
QA_RECENT_TURNS=6
# 历史 JSON 的 UTF-8 字节预算，保守估算 token 上界；范围 1000–32000。
QA_HISTORY_BUDGET=9000

DASHSCOPE_BASE_URL=https://llm-f9r7idf9omepz6cl.cn-beijing.maas.aliyuncs.com/api/v1
DASHSCOPE_API_KEY=replace-with-secret
DASHSCOPE_EMBEDDING_MODEL=qwen3-vl-embedding
DASHSCOPE_EMBEDDING_URL=
DASHSCOPE_EMBEDDING_MODE=multimodal
DASHSCOPE_EMBEDDING_DIMENSION=
DASHSCOPE_EMBEDDING_MAX_VIDEO_FRAMES=16
EMBEDDING_PROVIDER=dashscope
INDEX_WORKER_AUTOSTART=true


# RAG v2 retrieval and bounded context
QA_CONTEXT_TOKEN_BUDGET=12000
# lexical works locally; dashscope requires RERANK_API_KEY and RERANK_MODEL.
QA_RERANK_PROVIDER=lexical
RERANK_API_KEY=
RERANK_MODEL=
RERANK_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
# Enable to include prompts, history, retrieved text and responses in LangSmith.
LANGSMITH_CAPTURE_CONTENT=false
# Agent/environment destination; leave ID empty to use LANGSMITH_PROJECT.
LANGSMITH_AGENT_ID=
LANGSMITH_AGENT_ENVIRONMENT=local

# 评测后台任务：生产建议 false 并运行 flask --app app evaluation-worker
EVALUATION_WORKER_AUTOSTART=true
